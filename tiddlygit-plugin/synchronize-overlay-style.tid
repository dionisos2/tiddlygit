title: $:/plugins/dionisos/tiddlygit/synchronize-overlay-style
tags: $:/tags/Stylesheet

.tiddlygit-overlay {
	position: fixed;
	inset: 0;
	z-index: 10000;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(0,0,0,0.4);
}

.tiddlygit-overlay-box {
	padding: 1em 2em;
	border-radius: 6px;
	text-align: center;
	background: <<colour tiddler-background>>;
	color: <<colour foreground>>;
	box-shadow: 0 2px 12px rgba(0,0,0,0.4);
}
