title: $:/plugins/dionisos/tiddlygit/synchronize-notification

<$let code={{$:/temp/tiddlygit/synchronize!!code}}>
<%if [{$:/temp/tiddlygit/synchronize!!status}match[cancelled]] %>
Synchronization cancelled
<%elseif [<code>match[0]] %>
Synchronization successful
<%elseif [{$:/temp/tiddlygit/synchronize!!status}prefix[2]] %>
Synchronization failed (code <<code>>), see [[$:/temp/tiddlygit/synchronize]]
<%else%>
Synchronization request failed (HTTP status {{$:/temp/tiddlygit/synchronize!!status}})
<%endif%>
</$let>
